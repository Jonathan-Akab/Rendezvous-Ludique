// Rendezvous Ludique — data model.
//
// Local development runs on SQLite; production runs on PostgreSQL. The schema is kept
// portable (no provider-specific types), and `scripts/use-postgres.mjs` switches the
// provider below during the Docker build.
//
// Enum-like fields are stored as strings; their allowed values live in src/lib/constants.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────────── Members & auth ─────────────────────────────

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String
  displayName  String
  role         String @default("MEMBER") // MEMBER | MODERATOR | ADMIN
  status       String @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING (sign-up awaiting approval)
  // Console sections this admin or moderator may use (JSON array). For an ADMIN, null
  // means a full admin (everything, including giving rights to others).
  permissions  String?
  signupNote   String? // what the person wrote when signing up (helps the team approve)
  emailVerifiedAt DateTime? // set when the person clicked the confirmation link
  notifyPrefs     String? // JSON: email notifications the member turned on (all off by default)
  // Welcome guide: seen once (first sign-in); shown again at next sign-in if asked.
  guideSeenAt     DateTime?
  guideShowNext   Boolean   @default(false)
  guidePending    Boolean   @default(false)
  // Rules AI page views: the "how the AI is paid for" notice shows on the 1st and every 30th.
  aiNoticeViews   Int       @default(0)
  // "Coup de dé": the member's saved filter sets (JSON [{name, filters}])
  pickerPresets   String?
  // "Groupes Facebook": the tiles the member pinned on top (JSON list: "featured" or a group id)
  facebookPins    String?

  // Personalisation
  meepleColor String @default("#d9480f")
  theme       String @default("system")
  locale      String @default("fr")

  // Profile
  bio               String?
  city              String?
  region            String?
  latitude          Float?
  longitude         Float?
  favoriteGames     String? // free text, comma separated
  profileVisibility String  @default("MEMBERS") // PUBLIC | MEMBERS | FRIENDS | PRIVATE
  showLibrary       Boolean @default(true)
  showPlays         Boolean @default(true)
  navOrder          String? // JSON array of menu hrefs, the member's own sidebar order

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  sessions          Session[]
  sentFriendships   Friendship[]      @relation("FriendshipRequester")
  recvFriendships   Friendship[]      @relation("FriendshipAddressee")
  libraryMembers    LibraryMember[]
  kallaxOwned       KallaxGame[]      @relation("KallaxOwner")
  kallaxAdded       KallaxGame[]      @relation("KallaxAdder")
  hostedEvents      Event[]           @relation("EventHost")
  attendances       EventAttendee[]
  playsCreated      Play[]            @relation("PlayCreator")
  playParticipation PlayParticipant[]
  ludoFirstAdded    Game[]            @relation("LudoFirstAdder")
  auditLogs         AuditLog[]
  ratings           GameRating[]
  files             StoredFile[]
  rulebooks         Rulebook[]
  aiChats           AiChat[]
  suggestions       Suggestion[]
  announcements     Announcement[]
  suggestionVotes   SuggestionVote[]
  aiSetting         AiMemberSetting?
  playDraft         PlayDraft?
  aiUsage           AiUsage[]
  emailTokens       EmailToken[]
  bazaarListings    BazaarListing[]
  bazaarMessages    BazaarMessage[]   @relation("BazaarSender")
  bazaarThreads     BazaarMessage[]   @relation("BazaarBuyer")
}

model Session {
  id        String   @id // SHA-256 of the cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  status      String    @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// ───────────────────────────── Ludothèque ─────────────────────────────

// The site-wide game reference ("Ludothèque"). Nobody edits it directly: when a game is
// added to any Kallax we look it up by its normalised name and create it only if it
// doesn't exist yet. Ratings, rulebooks, plays, events and the bazar point here, so
// everyone shares the same game identity while each Kallax keeps its own private record.
model Game {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique // lowercase, no accents/punctuation — the duplicate check
  year           Int?
  minPlayers     Int?
  maxPlayers     Int?
  playTimeMin    Int?
  minAge         Int?
  weight         Float? // complexity 1–5
  designer       String?
  publisher      String?
  categories     String?
  description    String?
  imageUrl       String?
  coverFileId    String?
  bggId          Int?     @unique
  baseGameId     String? // set for an expansion: the game it extends
  createdById    String? // first member who added it to a Kallax
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  createdBy   User?           @relation("LudoFirstAdder", fields: [createdById], references: [id], onDelete: SetNull)
  baseGame    Game?           @relation("Expansions", fields: [baseGameId], references: [id], onDelete: SetNull)
  expansions  Game[]          @relation("Expansions")
  coverFile   StoredFile?     @relation("GameCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  kallaxGames KallaxGame[]
  plays       Play[]
  playExpansions PlayExpansion[] @relation("PlayExpansionGame")
  eventGames  EventGame[]
  ratings     GameRating[]
  rulebooks   Rulebook[]
  aiChats     AiChat[]
  faqs        RuleFaq[]
  listings    BazaarListing[]

  @@index([name])
}

// ───────────────────────────── Ma Kallax (libraries) ─────────────────────────────

// A library is a shelf that one or more members share (e.g. a couple).
model Library {
  id        String   @id @default(cuid())
  name      String
  // Who besides the members sharing it can see it (read-only): PRIVATE | FRIENDS | MEMBERS
  visibility String  @default("PRIVATE")
  createdAt DateTime @default(now())

  members LibraryMember[]
  games   KallaxGame[]
}

model LibraryMember {
  id        String   @id @default(cuid())
  libraryId String
  userId    String
  role      String   @default("MEMBER") // OWNER | MEMBER
  status    String   @default("PENDING") // PENDING | ACCEPTED
  invitedBy String?
  createdAt DateTime @default(now())

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([libraryId, userId])
  @@index([userId])
}

// A game on a Kallax shelf: the Kallax's own private record (its own name, details,
// picture, status and notes), linked to the shared Ludothèque entry by gameId.
model KallaxGame {
  id          String   @id @default(cuid())
  libraryId   String
  gameId      String
  addedById   String?
  ownerId     String? // which member physically owns the copy
  name        String
  year        Int?
  minPlayers  Int?
  maxPlayers  Int?
  playTimeMin Int?
  minAge      Int?
  designer    String?
  publisher   String?
  imageUrl    String?
  coverFileId String?
  status      String   @default("OWNED") // OWNED | WISHLIST | FOR_TRADE | PREORDERED
  condition   String?
  notes       String?
  parentId    String? // expansion: the Kallax record of its base game
  // plays not logged on the site (before joining, forgotten…); the counter shown adds the logged ones
  extraPlays  Int      @default(0)
  addedAt     DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  library   Library     @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  game      Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  addedBy   User?       @relation("KallaxAdder", fields: [addedById], references: [id], onDelete: SetNull)
  owner     User?       @relation("KallaxOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  coverFile StoredFile? @relation("KallaxCover", fields: [coverFileId], references: [id], onDelete: SetNull)
  // Removing the base game keeps its expansions (they become games of their own again).
  parent     KallaxGame?  @relation("KallaxExpansions", fields: [parentId], references: [id], onDelete: SetNull)
  expansions KallaxGame[] @relation("KallaxExpansions")

  @@unique([libraryId, gameId])
  @@index([parentId])
}

// ───────────────────────────── Events & home games ─────────────────────────────

model Event {
  id               String    @id @default(cuid())
  hostId           String
  title            String
  description      String?
  kind             String    @default("GAME_NIGHT") // GAME_NIGHT | BOARD_GAME_EVENT | TOURNAMENT | CONVENTION
  startsAt         DateTime
  endsAt           DateTime?
  locationName     String?
  address          String? // only shown to accepted attendees for home games
  city             String?
  latitude         Float?
  longitude        Float?
  visibility       String    @default("MEMBERS") // PUBLIC | MEMBERS | FRIENDS
  maxPlayers       Int?
  requiresApproval Boolean   @default(false)
  status           String    @default("SCHEDULED") // SCHEDULED | CANCELLED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  host      User            @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]
  games     EventGame[]
  plays     Play[]

  @@index([startsAt])
  @@index([city])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("GOING") // GOING | MAYBE | REQUESTED | DECLINED
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventGame {
  eventId String
  gameId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([eventId, gameId])
}

// ───────────────────────────── Play tracker ─────────────────────────────

model Play {
  id          String   @id @default(cuid())
  gameId      String
  createdById String
  eventId     String?
  playedAt    DateTime
  durationMin Int?
  location    String?
  notes       String?
  createdAt   DateTime @default(now())

  game         Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("PlayCreator", fields: [createdById], references: [id], onDelete: Cascade)
  event        Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  participants PlayParticipant[]
  expansions   PlayExpansion[]

  @@index([playedAt])
}

// A play being played or typed in ("Noter une partie" before it is saved): one per member,
// so closing the page (or switching devices) never loses the game, the scores or the clock.
model PlayDraft {
  userId    String    @id
  data      String // JSON: the form (game, date, expansions, players, scores, place, notes, length)
  startedAt DateTime? // the clock is running since then
  savedMs   Int       @default(0) // time counted before the last pause
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Expansions used during a play (Ludothèque games, expansions of the played game).
model PlayExpansion {
  playId String
  gameId String

  play Play @relation(fields: [playId], references: [id], onDelete: Cascade)
  game Game @relation("PlayExpansionGame", fields: [gameId], references: [id], onDelete: Cascade)

  @@id([playId, gameId])
}

// A seat at the table: either a member (userId) or a guest (guestName).
// Members other than the logger must accept before the play shows in their log.
model PlayParticipant {
  id        String  @id @default(cuid())
  playId    String
  userId    String?
  guestName String?
  score     Int?
  isWinner  Boolean @default(false)
  status    String  @default("CONFIRMED") // CONFIRMED | PENDING | DECLINED

  play Play  @relation(fields: [playId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Platform administration ─────────────────────────────

// One row per feature module. Admins toggle modules and tune their settings here.
model ModuleConfig {
  key       String   @id
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) // default menu position set by admins
  settings  String   @default("{}") // JSON
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  details   String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ───────────────────────────── Ratings, files, rulebooks ─────────────────────────────

// Each member's own rating of a game (1–10). The site-wide "meeple rating" is the average.
model GameRating {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  score     Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
}

// A file stored on disk (UPLOAD_DIR): game covers and rulebooks.
model StoredFile {
  id         String   @id @default(cuid())
  ownerId    String?
  kind       String // COVER | RULEBOOK | IMAGE | AI_IMAGE
  fileName   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  gameCover   Game[]       @relation("GameCover")
  kallaxCover KallaxGame[] @relation("KallaxCover")
  rulebook    Rulebook?
  bazaarPhoto BazaarPhoto?
}

model Rulebook {
  id           String   @id @default(cuid())
  gameId       String
  fileId       String   @unique
  title        String
  language     String   @default("fr")
  aiFileId     String? // Anthropic Files API id, uploaded on first AI question
  textContent  String? // JSON array of page texts, extracted for the free AI provider
  uploadedById String?
  createdAt    DateTime @default(now())

  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  file       StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  aiChats    AiChat[]
  faqs       RuleFaq[]

  @@index([gameId])
}

// ───────────────────────────── AI rules assistant ─────────────────────────────

model AiChat {
  id         String   @id @default(cuid())
  userId     String
  gameId     String?
  rulebookId String?
  kind       String   @default("chat") // conversation type; only "chat" for now
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  rulebook Rulebook?   @relation(fields: [rulebookId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  @@index([userId])
}

model AiMessage {
  id           String   @id @default(cuid())
  chatId       String
  role         String // user | assistant
  content      String
  citations    String? // JSON: [{ page, text }]
  imageIds     String? // JSON: ids of photos attached to a question (StoredFile, kind AI_IMAGE)
  provider     String? // claude | free (assistant messages)
  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([chatId])
}

// Per-member AI controls set by admins, plus the member's own provider choice.
model AiMemberSetting {
  userId            String   @id
  access            String   @default("DEFAULT") // DEFAULT | FREE_ONLY | NONE
  monthlyBudgetUsd  Float? // overrides the default per-member Claude budget
  dailyLimit        Int? // overrides the default questions per day
  preferredProvider String   @default("claude") // claude | free | own
  // The member's own Anthropic API key ("use my Claude credits"), encrypted with APP_SECRET.
  ownKeyEncrypted   String?
  ownKeyHint        String? // last characters, to recognise the key
  ownModel          String? // Claude model used with the member's key
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Facebook groups ─────────────────────────────

model FacebookGroup {
  id          String   @id @default(cuid())
  name        String
  url         String
  description String?
  region      String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ───────────────────────────── Bazar (games for sale or trade) ─────────────────────────────

model BazaarListing {
  id          String   @id @default(cuid())
  sellerId    String
  gameId      String?
  title       String
  description String?
  price       Float?
  kind        String   @default("SALE") // SALE | TRADE | BOTH
  condition   String   @default("GOOD") // NEW | LIKE_NEW | GOOD | FAIR | POOR
  delivery    String   @default("PICKUP") // PICKUP | SHIPPING | BOTH
  city        String?
  latitude    Float?
  longitude   Float?
  status      String   @default("ACTIVE") // ACTIVE | RESERVED | SOLD
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller   User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  game     Game?           @relation(fields: [gameId], references: [id], onDelete: SetNull)
  photos   BazaarPhoto[]
  messages BazaarMessage[]

  @@index([status, createdAt])
}

model BazaarPhoto {
  id        String @id @default(cuid())
  listingId String
  fileId    String @unique
  sortOrder Int    @default(0)

  listing BazaarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  file    StoredFile    @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

// Private conversation between the seller and one interested member (the "buyer").
model BazaarMessage {
  id        String    @id @default(cuid())
  listingId String
  buyerId   String
  senderId  String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  listing BazaarListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User          @relation("BazaarBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sender  User          @relation("BazaarSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([listingId, buyerId])
}

// Rules FAQ: built from the questions members ask the rules AI, one list per game.
// Similar questions are grouped (askCount); admins can verify, edit or hide answers.
model RuleFaq {
  id          String   @id @default(cuid())
  gameId      String
  rulebookId  String?
  question    String
  answer      String
  citations   String? // JSON: [{ page, endPage, text }]
  provider    String? // claude | free | manual
  status      String   @default("AUTO") // AUTO | VERIFIED | HIDDEN
  askCount    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game     Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rulebook Rulebook? @relation(fields: [rulebookId], references: [id], onDelete: SetNull)

  @@index([gameId])
}

// Suggestion box: members propose ideas and vote; duplicates become votes.
// "Babillard" on the home page: messages from the team, pinned ones first.
model Announcement {
  id        String   @id @default(cuid())
  body      String
  pinned    Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pinned, createdAt])
}

model Suggestion {
  id        String   @id @default(cuid())
  title     String
  details   String?
  authorId  String?
  status    String   @default("OPEN") // OPEN | PLANNED | DONE | DECLINED
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  votes  SuggestionVote[]

  @@index([status])
}

model SuggestionVote {
  suggestionId String
  userId       String
  createdAt    DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([suggestionId, userId])
  @@index([userId])
}

// AI calls outside the rules chat (e.g. reading game titles from Kallax photos), so their
// Claude cost counts in the same budgets as the rules questions.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  purpose      String // photo
  provider     String // claude | free | own
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// One-time links sent by email (confirm the address, reset the password). Only a hash of
// the token is stored; it expires and can be used once.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String // verify | reset
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

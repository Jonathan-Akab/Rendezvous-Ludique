# Local development uses SQLite. Production (Docker) uses PostgreSQL — see docker-compose.yml.
DATABASE_URL="file:./prisma/dev.db"

# First admin account created by `npm run db:seed` (local development only — change for production).
ADMIN_EMAIL="admin@rendezvous.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="meeple-admin-2026"

# Demo members created by the seed share this password (local development only).
DEMO_PASSWORD="meeple-demo-2026"

# Set to "true" to create demo members, games, events and plays when seeding.
SEED_DEMO_DATA="true"

# Uploaded files (game covers, rulebook PDFs).
UPLOAD_DIR="./storage"

# Rules AI module: an Anthropic API key (https://console.anthropic.com). Leave empty to
# keep the assistant disabled; the rest of the site works without it.
ANTHROPIC_API_KEY=""
# Free AI option (less reliable): API key for the OpenAI-compatible provider set in
# Admin → AI (default: Google Gemini free tier, key from https://aistudio.google.com).
FREE_AI_API_KEY=""
# BoardGameGeek app token (free): register at https://boardgamegeek.com/applications
# Used for collection imports and box picture suggestions.
BGG_API_TOKEN=""

# Encrypts secrets stored in the database (members' own Claude keys). 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""

# ── Email (SMTP) — any provider: Mailjet, Brevo, Gmail… (see docs/EMAIL-SETUP.md) ──
# Used for: email confirmation at sign-up, "forgot my password", notifications.
# Leave SMTP_HOST empty to turn email off (the site keeps working without it).
# Mailjet: host in-v3.mailjet.com, port 587, user = API key, password = secret key.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# The sender, verified at your provider. E.g. "Rendezvous Ludique <no-reply@example.com>"
MAIL_FROM=""
# The site's public address, used in the links of emails (no trailing slash).
APP_URL="http://localhost:3000"

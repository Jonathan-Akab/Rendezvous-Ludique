# Copy to .env.production and fill in real values. Never commit .env.production.
POSTGRES_PASSWORD="change-me-to-a-long-random-password"

ADMIN_EMAIL="you@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-too"

# Leave on "auto": session cookies get the Secure flag only when the site is reached over HTTPS.
COOKIE_SECURE="auto"
APP_PORT=3000

# Rules AI module (optional)
ANTHROPIC_API_KEY=""
FREE_AI_API_KEY=""

# BoardGameGeek app token (free): register at https://boardgamegeek.com/applications
# Used for collection imports and box picture suggestions.
BGG_API_TOKEN=""

# Encrypts secrets stored in the database (members' own Claude keys). 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it: changing it makes saved member keys unreadable (they would have to re-enter them).
APP_SECRET=""

# ── Email (SMTP) — any provider: Mailjet, Brevo, Gmail… (see docs/EMAIL-SETUP.md) ──
# Used for: email confirmation at sign-up, "forgot my password", notifications.
# Leave SMTP_HOST empty to turn email off (the site keeps working without it).
# Mailjet: host in-v3.mailjet.com, port 587, user = API key, password = secret key.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# The sender, verified at your provider. E.g. "Rendezvous Ludique <no-reply@example.com>"
MAIL_FROM=""
# The site's public address, used in the links of emails (no trailing slash).
APP_URL="https://your-domain.example"

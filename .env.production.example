# Copy to .env.production and fill in real values. Never commit .env.production.
POSTGRES_PASSWORD="change-me-to-a-long-random-password"

ADMIN_EMAIL="you@example.com"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-too"

# "false" only when the site is served over plain HTTP (no HTTPS).
COOKIE_SECURE="true"
APP_PORT=3000

# Rules AI module (optional)
ANTHROPIC_API_KEY=""FREE_AI_API_KEY=""
